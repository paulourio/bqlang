{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BigQuery SQL (bqlang)",
  "scopeName": "source.bqlang",
  "patterns": [
    {
      "include": "#jinja"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#identifiers-quoted"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#dual-role-functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    }
  ],
  "repository": {
    "jinja": {
      "patterns": [
        {
          "include": "#jinja-comment"
        },
        {
          "include": "#jinja-raw"
        },
        {
          "include": "#jinja-expression"
        },
        {
          "include": "#jinja-block"
        }
      ]
    },
    "jinja-comment": {
      "name": "comment.block.jinja.bqlang",
      "begin": "\\{#[-+]?",
      "end": "[-+]?#\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.jinja.bqlang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.jinja.bqlang"
        }
      }
    },
    "jinja-raw": {
      "name": "meta.embedded.raw.jinja.bqlang",
      "begin": "\\{%[-+]?\\s*raw\\s*[-+]?%\\}",
      "end": "\\{%[-+]?\\s*endraw\\s*[-+]?%\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-block.begin.jinja.bqlang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-block.end.jinja.bqlang"
        }
      },
      "contentName": "markup.raw.jinja.bqlang"
    },
    "jinja-expression": {
      "name": "meta.embedded.expression.jinja.bqlang",
      "begin": "\\{\\{[-+]?",
      "end": "[-+]?\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.jinja.bqlang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.jinja.bqlang"
        }
      },
      "patterns": [
        {
          "include": "#jinja-inner"
        }
      ]
    },
    "jinja-block": {
      "name": "meta.embedded.block.jinja.bqlang",
      "begin": "\\{%[-+]?",
      "end": "[-+]?%\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-block.begin.jinja.bqlang"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-block.end.jinja.bqlang"
        }
      },
      "patterns": [
        {
          "name": "keyword.control.jinja.bqlang",
          "match": "\\b(?:if|elif|else|endif|for|endfor|set|endset|macro|endmacro|call|endcall|do|raw|endraw|block|endblock|extends|include|import|from|filter|endfilter|with|endwith|break|continue|print|autoescape|endautoescape|trans|endtrans|debug)\\b"
        },
        {
          "include": "#jinja-inner"
        }
      ]
    },
    "jinja-inner": {
      "patterns": [
        {
          "name": "string.quoted.single.jinja.bqlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.jinja.bqlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.jinja.bqlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jinja.bqlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.jinja.bqlang",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
        },
        {
          "name": "keyword.other.jinja.bqlang",
          "match": "\\b(?:in|not|and|or|is|if|else|as|with|without|recursive)\\b"
        },
        {
          "name": "constant.language.jinja.bqlang",
          "match": "\\b(?:true|false|none|True|False|None)\\b"
        },
        {
          "name": "support.function.dbt.jinja.bqlang",
          "match": "\\b(?:ref|source|config|var|is_incremental|env_var|log|return|exceptions|adapter|this|target|execute|schema|database|loop)\\b"
        },
        {
          "name": "entity.name.function.jinja.bqlang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*\\("
        },
        {
          "name": "keyword.operator.jinja.bqlang",
          "match": "==|!=|<=|>=|\\*\\*|//|[|~+\\-*/%<>=]"
        },
        {
          "name": "variable.other.jinja.bqlang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.bqlang",
          "match": "--.*$"
        },
        {
          "name": "comment.line.number-sign.bqlang",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.bqlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bqlang",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.bqlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.bqlang"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.single.bqlang",
          "begin": "(?i)(?:\\b(?:rb|br|[rb]))?'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.bqlang",
              "match": "\\\\."
            },
            {
              "include": "#jinja"
            }
          ]
        },
        {
          "name": "string.quoted.triple.double.bqlang",
          "begin": "(?i)(?:\\b(?:rb|br|[rb]))?\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.bqlang",
              "match": "\\\\."
            },
            {
              "include": "#jinja"
            }
          ]
        },
        {
          "name": "string.quoted.single.bqlang",
          "begin": "(?i)(?:\\b(?:rb|br|[rb]))?'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.bqlang",
              "match": "\\\\."
            },
            {
              "include": "#jinja"
            }
          ]
        },
        {
          "name": "string.quoted.double.bqlang",
          "begin": "(?i)(?:\\b(?:rb|br|[rb]))?\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.bqlang",
              "match": "\\\\."
            },
            {
              "include": "#jinja"
            }
          ]
        }
      ]
    },
    "identifiers-quoted": {
      "name": "entity.name.tag.backtick.bqlang",
      "begin": "`",
      "end": "`|$",
      "patterns": [
        {
          "name": "constant.character.escape.bqlang",
          "match": "\\\\."
        },
        {
          "include": "#jinja"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.sysvar.bqlang",
          "match": "@@[A-Za-z_][A-Za-z0-9_.]*"
        },
        {
          "name": "variable.parameter.bqlang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.bqlang",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.bqlang",
          "match": "->|=>|\\|\\||<<|>>|<>|!=|<=|>=|\\+=|-=|[+\\-*/%=<>&|^~!]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.bqlang",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.bqlang",
          "match": "\\b[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.float.bqlang",
          "match": "\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.bqlang",
          "match": "(?i)\\b(?:TRUE|FALSE)\\b"
        },
        {
          "name": "constant.language.null.bqlang",
          "match": "(?i)\\bNULL\\b"
        },
        {
          "name": "variable.language.pseudo.bqlang",
          "match": "(?i)\\b(?:_PARTITIONTIME|_PARTITIONDATE|_TABLE_SUFFIX)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.bqlang",
          "match": "(?i)\\b(?:INT64|INT|SMALLINT|INTEGER|BIGINT|TINYINT|BYTEINT|FLOAT64|FLOAT|DOUBLE|NUMERIC|DECIMAL|BIGNUMERIC|BIGDECIMAL|BOOL|BOOLEAN|STRING|BYTES|DATE|DATETIME|TIME|TIMESTAMP|INTERVAL|GEOGRAPHY|JSON|UUID|ANY|ARRAY|STRUCT|RANGE|MAP)\\b"
        }
      ]
    },
    "dual-role-functions": {
      "patterns": [
        {
          "match": "(?i)\\b(IF|LEFT|RIGHT|CAST|EXTRACT|COLLATE|NEXT|SEARCH|GROUPING|REPEAT|REPLACE|LOG)\\s*\\(",
          "captures": {
            "1": {
              "name": "support.function.bigquery.bqlang"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.bigquery.namespaced.bqlang",
          "match": "(?i)\\b(?:AI\\.(?:FORECAST|GENERATE(?:_BOOL|_DOUBLE|_INT|_TABLE|_TEXT)?|SEARCH)|ML\\.(?:EVALUATE|PREDICT)|HLL_COUNT\\.(?:EXTRACT|INIT|MERGE(?:_PARTIAL)?)|NET\\.(?:HOST|IP_FROM_STRING|IP_NET_MASK|IP_TO_STRING|IP_TRUNC|IPV4_FROM_INT64|IPV4_TO_INT64|PUBLIC_SUFFIX|REG_DOMAIN|SAFE_IP_FROM_STRING)|AEAD\\.(?:DECRYPT_BYTES|DECRYPT_STRING|ENCRYPT)|KEYS\\.(?:ADD_KEY_FROM_RAW_BYTES|KEYSET_CHAIN|KEYSET_FROM_JSON|KEYSET_LENGTH|KEYSET_TO_JSON|NEW_KEYSET|NEW_WRAPPED_KEYSET|REWRAP_KEYSET|ROTATE_KEYSET|ROTATE_WRAPPED_KEYSET))\\b"
        },
        {
          "name": "support.function.bigquery.bqlang",
          "match": "(?i)\\b(?:ABS|ACOS|ACOSH|AGG|ALL_DIFFERENT|ANY_VALUE|APPROX_COUNT_DISTINCT|APPROX_QUANTILES|APPROX_TOP_COUNT|APPROX_TOP_SUM|ARRAY_AGG|ARRAY_CONCAT|ARRAY_CONCAT_AGG|ARRAY_FIRST|ARRAY_LAST|ARRAY_LENGTH|ARRAY_REVERSE|ARRAY_SLICE|ARRAY_TO_STRING|ARRAY_TRANSFORM|ASCII|ASIN|ASINH|ATAN|ATAN2|ATANH|AVG|BIT_AND|BIT_COUNT|BIT_OR|BIT_XOR|BYTE_LENGTH|CAST|CBRT|CEIL|CEILING|CHAR_LENGTH|CHARACTER_LENGTH|CHR|CLASSIFIER|COALESCE|CODE_POINTS_TO_BYTES|CODE_POINTS_TO_STRING|COLLATE|CONCAT|CONTAINS_SUBSTR|CORR|COS|COSH|COSINE_DISTANCE|COT|COTH|COUNT|COUNTIF|COVAR_POP|COVAR_SAMP|CSC|CSCH|CUME_DIST|CURRENT_DATE|CURRENT_DATETIME|CURRENT_TIME|CURRENT_TIMESTAMP|DATE_ADD|DATE_DIFF|DATE_FROM_UNIX_DATE|DATE_SUB|DATE_TRUNC|DATETIME_ADD|DATETIME_DIFF|DATETIME_SUB|DATETIME_TRUNC|DENSE_RANK|DESTINATION_NODE_ID|DETERMINISTIC_DECRYPT_BYTES|DETERMINISTIC_DECRYPT_STRING|DETERMINISTIC_ENCRYPT|DIV|DOT_PRODUCT|EDGES|EDIT_DISTANCE|ELEMENT_ID|ENDS_WITH|ERROR|EUCLIDEAN_DISTANCE|EXP|EXTERNAL_OBJECT_TRANSFORM|EXTRACT|FARM_FINGERPRINT|FIRST|FIRST_VALUE|FLOOR|FORMAT|FORMAT_DATE|FORMAT_DATETIME|FORMAT_TIME|FORMAT_TIMESTAMP|FROM_BASE32|FROM_BASE64|FROM_HEX|GENERATE_ARRAY|GENERATE_DATE_ARRAY|GENERATE_TIMESTAMP_ARRAY|GENERATE_UUID|GRAPH_EXPAND|GREATEST|GROUPING|IEEE_DIVIDE|IF|IFNULL|INITCAP|INSTR|IS_ACYCLIC|IS_INF|IS_NAN|IS_SIMPLE|IS_TRAIL|JSON_ARRAY|JSON_EXTRACT|JSON_EXTRACT_ARRAY|JSON_EXTRACT_SCALAR|JSON_EXTRACT_STRING_ARRAY|JSON_KEYS|JSON_OBJECT|JSON_QUERY|JSON_QUERY_ARRAY|JSON_REMOVE|JSON_SET|JSON_STRIP_NULLS|JSON_TYPE|JSON_VALUE|JSON_VALUE_ARRAY|JUSTIFY_DAYS|JUSTIFY_HOURS|JUSTIFY_INTERVAL|LABELS|LAG|LAST|LAST_DAY|LAST_VALUE|LAX_BOOL|LAX_FLOAT64|LAX_INT64|LAX_STRING|LEAD|LEAST|LEFT|LENGTH|LN|LOG|LOG10|LOGICAL_AND|LOGICAL_OR|LOWER|LPAD|LTRIM|MAKE_INTERVAL|MANHATTAN_DISTANCE|MATCH_NUMBER|MATCH_ROW_NUMBER|MAX|MAX_BY|MD5|MEASURE|MIN|MIN_BY|MOD|NEXT|NODES|NORMALIZE|NORMALIZE_AND_CASEFOLD|NTH_VALUE|NTILE|NULLIF|NULLIFZERO|OCTET_LENGTH|OFFSET|ORDINAL|PARSE_BIGNUMERIC|PARSE_DATE|PARSE_DATETIME|PARSE_JSON|PARSE_NUMERIC|PARSE_TIME|PARSE_TIMESTAMP|PATH_FIRST|PATH_LAST|PATH_LENGTH|PERCENT_RANK|PERCENTILE_CONT|PERCENTILE_DISC|PI|POW|POWER|PREV|RAND|RANGE_BUCKET|RANK|REGEXP_CONTAINS|REGEXP_EXTRACT|REGEXP_EXTRACT_ALL|REGEXP_INSTR|REGEXP_REPLACE|REGEXP_SUBSTR|REPEAT|REPLACE|REVERSE|RIGHT|ROUND|ROW_NUMBER|RPAD|RTRIM|S2_CELLIDFROMPOINT|S2_COVERINGCELLIDS|SAFE_ADD|SAFE_CAST|SAFE_CONVERT_BYTES_TO_STRING|SAFE_DIVIDE|SAFE_MULTIPLY|SAFE_NEGATE|SAFE_OFFSET|SAFE_ORDINAL|SAFE_SUBTRACT|SAME|SEARCH|SEC|SECH|SESSION_USER|SHA1|SHA256|SHA512|SIGN|SIN|SINH|SOUNDEX|SOURCE_NODE_ID|SPLIT|SQRT|ST_[A-Z0-9_]+|STARTS_WITH|STDDEV|STDDEV_POP|STDDEV_SAMP|STRING_AGG|STRPOS|SUBSTR|SUBSTRING|SUM|TAN|TANH|TIME_ADD|TIME_DIFF|TIME_SUB|TIME_TRUNC|TIMESTAMP_ADD|TIMESTAMP_DIFF|TIMESTAMP_MICROS|TIMESTAMP_MILLIS|TIMESTAMP_SECONDS|TIMESTAMP_SUB|TIMESTAMP_TRUNC|TO_BASE32|TO_BASE64|TO_CODE_POINTS|TO_HEX|TO_JSON|TO_JSON_STRING|TRANSLATE|TRIM|TRUNC|TYPEOF|UNICODE|UNIX_DATE|UNIX_MICROS|UNIX_MILLIS|UNIX_SECONDS|UPPER|VAR_POP|VAR_SAMP|VARIANCE|VECTOR_SEARCH|ZEROIFNULL)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bqlang",
          "match": "(?i)\\b(?:ASSERT|BEGIN|BREAK|CALL|CASE|CONTINUE|DECLARE|DO|ELSE|ELSEIF|ELSIF|END|EXCEPTION|EXECUTE|FOR|IF|IMMEDIATE|ITERATE|LEAVE|LOOP|RAISE|REPEAT|RETURN|SET|THEN|UNTIL|WHEN|WHILE)\\b"
        },
        {
          "name": "keyword.other.ddl.bqlang",
          "match": "(?i)\\b(?:ADD|ALTER|CLONE|CLUSTER|COLUMN|CONNECTION|COPY|CREATE|DATA|DEFAULT|DROP|ENFORCED|EXPORT|EXTERNAL|FOREIGN|FUNCTION|GENERATED|GRANT|HIDDEN|IDENTITY|INDEX|INPUT|KEY|LIKE|LOAD|MATERIALIZED|MODEL|OPTIONS|OUTPUT|OVERWRITE|PARTITION|PARTITIONS|POLICY|PRIMARY|PROCEDURE|PROPERTY|REBUILD|REFERENCES|REPLACE|REPLICA|REVOKE|ROW|SCHEMA|SEARCH|SNAPSHOT|STORED|TABLE|TEMP|TEMPORARY|TRANSFORM|TRUNCATE|TTL|UNDROP|VECTOR|VIEW)\\b"
        },
        {
          "name": "keyword.other.dml.bqlang",
          "match": "(?i)\\b(?:ACTION|ASSERT_ROWS_MODIFIED|DELETE|INSERT|INTO|MATCHED|MERGE|SOURCE|TARGET|UPDATE|VALUES)\\b"
        },
        {
          "name": "keyword.other.pipe.bqlang",
          "match": "(?i)\\b(?:AGGREGATE|DESCRIBE|EXTEND|FORK|LOG|RENAME|STATIC_DESCRIBE|TEE)\\b"
        },
        {
          "name": "keyword.other.gql.bqlang",
          "match": "(?i)\\b(?:ACYCLIC|DESTINATION|FILTER|GRAPH|GRAPH_TABLE|LABELED|LET|NEXT|OPTIONAL|PATH|SIMPLE|TRAIL)\\b"
        },
        {
          "name": "keyword.other.query.bqlang",
          "match": "(?i)\\b(?:ALL|AND|AS|ASC|AT|BETWEEN|BY|COLLATE|CORRESPONDING|CROSS|CUBE|CURRENT|DESC|DISTINCT|ENUM|EXCEPT|EXISTS|FETCH|FOLLOWING|FROM|FULL|GROUP|GROUPING|GROUPS|HAVING|IGNORE|IN|INNER|INTERSECT|IS|JOIN|LATERAL|LEFT|LIMIT|MATCH|MATCH_RECOGNIZE|NATURAL|NOT|NULLS|OF|ON|ONLY|OR|ORDER|OUTER|OVER|PERCENT|PIVOT|PRECEDING|PREWHERE|PRIVATE|PROTO|PUBLIC|QUALIFY|QUANTIFIER|RECURSIVE|RESPECT|RIGHT|ROLLUP|ROWS|SELECT|SETS|SOME|STRICT|SYSTEM|SYSTEM_TIME|TABLESAMPLE|TOP|UNBOUNDED|UNION|UNNEST|UNPIVOT|USING|VALUE|WHERE|WINDOW|WITH|WITHIN|ZONE)\\b"
        }
      ]
    }
  }
}
